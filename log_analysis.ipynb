# Запустите в Google Colab: https://colab.research.google.com

import json
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path
import numpy as np

# 🟢 ЗАГРУЗКА ЛОГОВ
def load_logs(student_name):
    """Загружает все логи студента"""
    log_files = list(Path('.').glob(f'log_{student_name}_*.json'))
    
    if not log_files:
        print(f"❌ Логи для {student_name} не найдены!")
        print("💡 Загрузите файлы log_*.json из вашего репозитория")
        return None
    
    logs = []
    for f in log_files:
        with open(f, 'r', encoding='utf-8') as file:
            data = json.load(file)
            data['source_file'] = f.name
            logs.append(data)
    
    print(f"✅ Загружено логов: {len(logs)}")
    return logs

# 🟢 ВИЗУАЛИЗАЦИЯ МАРШРУТА
def plot_route(log_data):
    """Рисует маршрут героя"""
    fig, ax = plt.subplots(figsize=(12, 8))
    
    for log_entry in log_data:
        log_entries = log_entry.get('log', [])
        if not log_entries:
            continue
        
        x_coords = [e.get('x', 0) for e in log_entries]
        y_coords = [e.get('y', 0) for e in log_entries]
        
        ax.plot(x_coords, y_coords, '-', alpha=0.5, 
                label=log_entry.get('source_file', 'unknown')[:20])
        
        # Старт и финиш
        if x_coords:
            ax.plot(x_coords[0], y_coords[0], 'go', markersize=15, label='Start')
            ax.plot(x_coords[-1], y_coords[-1], 'rs', markersize=15, label='Finish')
    
    ax.set_xlabel('X координата')
    ax.set_ylabel('Y координата')
    ax.set_title('🗺️ Маршрут движения героя')
    ax.grid(True, alpha=0.3)
    ax.legend()
    plt.show()

# 🟢 СТАТИСТИКА
def analyze_performance(logs):
    """Анализирует эффективность"""
    stats = []
    
    for log_entry in logs:
        stats.append({
            'file': log_entry.get('source_file', 'unknown'),
            'steps': log_entry.get('total_steps', 0),
            'penalties': log_entry.get('total_penalties', 0),
            'score': log_entry.get('total_steps', 0) - log_entry.get('total_penalties', 0),
            'reason': log_entry.get('reason', 'unknown'),
            'events': len(log_entry.get('log', []))
        })
    
    df = pd.DataFrame(stats)
    print("\n📊 СТАТИСТИКА ПО ИГРАМ:")
    print(df.to_string(index=False))
    
    # График
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
    # Steps по играм
    axes[0, 0].bar(range(len(df)), df['steps'], color='skyblue')
    axes[0, 0].set_title('👣 Шаги по играм')
    axes[0, 0].set_xlabel('Игра')
    axes[0, 0].set_ylabel('Шаги')
    
    # Penalties по играм
    axes[0, 1].bar(range(len(df)), df['penalties'], color='salmon')
    axes[0, 1].set_title('⚠️ Штрафы по играм')
    axes[0, 1].set_xlabel('Игра')
    axes[0, 1].set_ylabel('Штрафы')
    
    # Score по играм
    axes[1, 0].bar(range(len(df)), df['score'], color='lightgreen')
    axes[1, 0].set_title('📊 Счёт по играм')
    axes[1, 0].set_xlabel('Игра')
    axes[1, 0].set_ylabel('Счёт')
    
    # Распределение событий
    axes[1, 1].pie([len(logs), len(logs)*10], 
                   labels=['Игры', 'События (примерно)'],
                   autopct='%1.1f%%')
    axes[1, 1].set_title('📈 Объём данных')
    
    plt.tight_layout()
    plt.show()
    
    return df

# 🟢 ЗАПУСК
if __name__ == "__main__":
    # Введите ваше имя (как в игре)
    student_name = input("👤 Введите ваше имя: ").strip().lower()
    
    if not student_name:
        student_name = "anonymous"
    
    # Загрузка
    logs = load_logs(student_name)
    
    if logs:
        # Визуализация
        plot_route(logs)
        
        # Анализ
        df = analyze_performance(logs)
        
        # Сохранение отчёта
        df.to_csv(f'analysis_{student_name}.csv', index=False)
        print(f"\n💾 Отчёт сохранён: analysis_{student_name}.csv")
